# =============================================================================
# Marketplace Ministers API — Environment Configuration
# =============================================================================
# Copy to .env and adjust per environment.
# Local default: SQLite. Production (Laravel Forge + Hostinger): MySQL 8+.
# =============================================================================

APP_NAME="Marketplace Ministers API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT (default): SQLite — do not change this for day-to-day work.
DB_CONNECTION=sqlite
# DB_DATABASE= # optional absolute path; defaults to database/database.sqlite

# PRODUCTION (Laravel Forge + Hostinger): MySQL 8+
# Uncomment and fill these on the server only. Do NOT switch local .env to MySQL
# unless you intentionally maintain a separate MySQL sandbox.
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketplace_ministers
# DB_USERNAME=
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# Optional: PostgreSQL (supported by Laravel, not the Forge target for this project)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=marketplace_ministers
# DB_USERNAME=marketplace
# DB_PASSWORD=
# DB_CHARSET=utf8

# -----------------------------------------------------------------------------
# Session (database driver uses sessions table from migrations)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production HTTPS (Forge):
# SESSION_DOMAIN=.your-domain.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Cache (redis recommended for production; file is the safe artisan default)
# -----------------------------------------------------------------------------
CACHE_STORE=file
# CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=mm_api_

# -----------------------------------------------------------------------------
# Queue (redis + supervisor recommended for production)
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail (configure before enabling transactional email)
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@marketplaceministers.org"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Filesystem / media storage
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_PREFIX=api
API_VERSION=v1
API_INCLUDE_REQUEST_ID=true
API_INCLUDE_TIMESTAMP=true

# -----------------------------------------------------------------------------
# SPA frontend (CORS + Sanctum — single source of truth)
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:8081
FRONTEND_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173
# Extra Sanctum stateful hosts (API self-requests, IPv6 loopback)
SANCTUM_STATEFUL_DOMAINS_EXTRA=127.0.0.1:8000,::1

# Production Forge / Hostinger notes:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com
# FRONTEND_URL=https://your-domain.com
# FRONTEND_ORIGINS=https://your-domain.com,https://www.your-domain.com
# SESSION_DOMAIN=.your-domain.com
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# TRUSTED_PROXIES=*
# SANCTUM_STATEFUL_DOMAINS_EXTRA=your-domain.com,www.your-domain.com
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# FILESYSTEM_DISK=local
# MAIL_MAILER=smtp
# MAIL_HOST=...
# MAIL_PORT=587
# MAIL_USERNAME=...
# MAIL_PASSWORD=...
# MAIL_FROM_ADDRESS=noreply@your-domain.com

BROADCAST_CONNECTION=log

VITE_APP_NAME="${APP_NAME}"
